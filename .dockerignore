# Keep the build context lean and runtime state out of the image.
.git
.gitignore
.gitattributes

# Frontend build outputs & deps (rebuilt inside the image)
node_modules
dist

# Backend virtualenv & collected static (installed/collected inside the image)
backend/.venv
backend/staticfiles

# Runtime state — must never be baked into an image layer
server/data

# Python artifacts
**/__pycache__
**/*.pyc

# Tooling, docs, editor files
.vscode
.idea
logs
*.log
scripts
AGENTS.md
CLAUDE.md
README.md
eslint.config.js
jsconfig.json
components.json

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
