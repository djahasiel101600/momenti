# ============================================================================
# momenti — environment template
#
# Copy to `.env` (same directory as docker-compose.yml) and adjust for your
# deployment:   cp .env.example .env
# docker compose auto-loads `.env`; every value below has a working default
# that matches docker-compose.yml, so an empty .env is fine too.
# ============================================================================

# --- Cloudflare tunnel / hosting -------------------------------------------
# The public hostname your tunnel serves. It MUST appear in
# MOMENTI_ALLOWED_HOSTS — a Host header outside this list makes Django
# answer every request with 400 (DisallowedHost).
MOMENTI_ALLOWED_HOSTS=momenti.jdp-homelab.space,momenti,localhost,127.0.0.1

# Public origin: used in password-reset links and as the trusted origin for
# /admin/ logins through the tunnel.
MOMENTI_PUBLIC_ORIGIN=https://momenti.jdp-homelab.space
MOMENTI_CSRF_TRUSTED_ORIGINS=https://momenti.jdp-homelab.space

# --- Security ---------------------------------------------------------------
# HMAC key for bearer tokens. Leave commented to have the app generate one
# on first boot and persist it in the data directory (recommended). To pin
# it (e.g. for multi-replica setups), use a long random string:
#   python -c "import secrets; print(secrets.token_hex(48))"
# DJANGO_SECRET_KEY=

# --- Runtime toggles ---------------------------------------------------------
# Keep both "off" in production. MOMENTI_DEV_HELPERS=on surfaces OTP codes /
# reset links in API responses (handy for local testing only).
MOMENTI_DEBUG=off
MOMENTI_DEV_HELPERS=off

# --- Gunicorn (inside the container) ----------------------------------------
# gthread workers: each worker handles GUNICORN_THREADS concurrent requests,
# so large media uploads never block the API.
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
# Keep-alive above Cloudflare's idle-reuse window (gunicorn default is 2s,
# which causes intermittent 502 Bad Gateway on POSTs behind the tunnel).
GUNICORN_KEEPALIVE=75
# PORT=8000

# --- Email (SMTP) for verification codes & password-reset links ---------------
# Uncomment and fill in to send real email. When MOMENTI_EMAIL_HOST is set,
# the OTP/reset helpers are emailed to the user and the dev helpers disappear
# from API responses. Leave all commented to keep the local dev helpers.
# MOMENTI_EMAIL_HOST=smtp.example.com
# MOMENTI_EMAIL_PORT=587
# MOMENTI_EMAIL_USER=no-reply@example.com
# MOMENTI_EMAIL_PASSWORD=<app password>
# # From address; defaults to "momenti <no-reply@<host>>":
# MOMENTI_EMAIL_FROM=momenti <no-reply@example.com>
# TLS on port 587 (set MOMENTI_EMAIL_USE_SSL=true instead for port 465):
# MOMENTI_EMAIL_USE_TLS=true
# MOMENTI_EMAIL_USE_SSL=false

# --- SaaS billing (Phase 2) ----------------------------------------------------
# Quota enforcement (plan limits: invitations + media storage). Turn OFF for
# dev/unlimited behavior. The legacy Node backend never enforced quotas.
MOMENTI_QUOTA_ENFORCEMENT=on

# Manual admin activation toggle - the pre-PayMongo way to grant a plan:
#   docker compose exec momenti python manage.py billing_activate --email host@x.com --plan pro
# (also configurable under /admin/ -> Subscriptions, and via
# POST /api/billing/subscription/activate for staff). Turn OFF once the
# PayMongo checkout/webhook path is live so only the provider grants plans.
MOMENTI_BILLING_MANUAL_ACTIVATION=on

# Pro plan monthly price, in centavos (₱499.00 = 49900; ₱300.00 = 30000).
# Applied to the seeded Pro plan at every container boot — when set it wins
# over price edits made under /admin/. Leave unset to manage the price via
# /admin/ only (seeded default: 49900 = ₱499.00/month).
# MOMENTI_PRO_PRICE_CENTS=49900
# --- PayMongo checkout + webhook (SaaS Phase 3) ---------------------------------
# Paid-plan upgrades run through PayMongo-hosted checkout (GCash / Maya / card).
# Set MOMENTI_PAYMONGO_SECRET_KEY (sk_test_... or sk_live_...) to enable the
# upgrade buttons on /studio/billing. In the PayMongo dashboard create a webhook
# pointing at  https://<your-domain>/api/billing/webhook  and copy its secret
# below — paid events are only honored when the Paymongo-Signature verifies.
# MOMENTI_PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# MOMENTI_PAYMONGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# MOMENTI_PAYMONGO_MODE=test
# Payment methods at checkout (comma-separated). Type strings per PayMongo's
# docs: gcash, paymaya (Maya), card, grab_pay, qrph, billease, brankas. New
# PayMongo accounts often start with GCash/Maya only — remove "card" until
# card payments are activated or checkout creation fails with a 400.
# QR Ph only (no e-wallet onboarding needed — customers scan with any bank or
# e-wallet app): MOMENTI_PAYMONGO_METHODS=qrph
# MOMENTI_PAYMONGO_METHODS=gcash,paymaya
# Checkout flow: "hosted" (default) sends the buyer to PayMongo's checkout
# page; "qrph" renders a scannable QR Ph code directly on the Billing page
# (Payment Intents API — no redirect). Requires QR Ph active on the account.
# MOMENTI_PAYMONGO_FLOW=qrph

# --- Throttling (per-IP) -------------------------------------------------------

# --- Throttling (per-IP) -------------------------------------------------------
# Public endpoints (register / login / resend-otp / reset-password / rsvp) are
# throttled to blunt email-bombing, credential-stuffing, and RSVP spam.
# Scoped rates apply per-view; anon/user apply globally. Adjust for traffic.
MOMENTI_THROTTLE_ANON=20/minute
MOMENTI_THROTTLE_USER=60/minute
MOMENTI_THROTTLE_LOGIN=10/minute
MOMENTI_THROTTLE_OTP=5/minute
MOMENTI_THROTTLE_RSVP=10/minute

# Optional PayMongo webhook secret for live mode (whsec_live_...):
# MOMENTI_PAYMONGO_WEBHOOK_SECRET=whsec_live_xxx

# --- Business / marketing info (power the public marketing pages) --------------
# Served at runtime via /api/app/settings. Blank values hide the empty blocks
# on the pages (no fake placeholders). Change these then `docker compose up -d`.
MOMENTI_BUSINESS_NAME=Moments Studio
MOMENTI_BUSINESS_TAGLINE=Invitations that become keepsakes.
MOMENTI_BUSINESS_CONTACT_EMAIL=djahasiel@gmail.com
MOMENTI_BUSINESS_LOCATIONS=Santa Ana, Tubay, Agusan del Norte
# Comma-separated "Name=URL" pairs — only listed ones show in the footer:
MOMENTI_BUSINESS_SOCIALS=Instagram=https://www.instagram.com/momentsstudio,Facebook=https://www.facebook.com/momentsstudio,TikTok=https://www.tiktok.com/@momentsstudio
# Where the hero "View sample" button + template cards link (e.g. /studio):
MOMENTI_HERO_SAMPLE_LINK=/studio
# White-label branding (also editable in /admin -> White-label; DB overrides win
# over env, blanks fall back to these):
# MOMENTI_BRAND_ACCENT_COLOR=#C58A58
# MOMENTI_BRAND_ACCENT_HOVER_COLOR=#D89A68
# MOMENTI_BRAND_FAVICON_URL=https://example.com/favicon.png
# MOMENTI_BRAND_LOGO_URL=https://example.com/logo.png

# --- Legal pages (optional) ----------------------------------------------------
# Absolute URLs. When set, the SPA footer and auth pages link to them; when
# blank, the links hide themselves — fine for a private/self-hosted install.
# MOMENTI_TERMS_URL=https://example.com/terms
# MOMENTI_PRIVACY_URL=https://example.com/privacy

# --- Database -----------------------------------------------------------------
# SQLite (default) is fine for a single instance. To switch to the bundled
# Postgres service: set MOMENTI_DB_ENGINE=postgres, then migrate existing data
# (dumpdata on SQLite -> loaddata on Postgres - steps in README).
# MOMENTI_DB_ENGINE=postgres
MOMENTI_DB_NAME=momenti
MOMENTI_DB_USER=momenti
MOMENTI_DB_PASSWORD=momenti-change-me
# MOMENTI_DB_HOST=postgres
# MOMENTI_DB_PORT=5432

# --- Local development only (not used by the container) ----------------------
# Data dir for bare-metal runs: SQLite DB, uploads, signing secret.
# MOMENTI_DATA_DIR=./server/data
# Backend selection for `npm run dev`: django (default) | node
# MOMENTI_BACKEND=node
# Proxy target for `npm run dev` when using the Django backend:
# MOMENTI_DJANGO_ORIGIN=http://127.0.0.1:8000
# Legacy standalone Node server port (npm start):
# MOMENTI_PORT=8787
